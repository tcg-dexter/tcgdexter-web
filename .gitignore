# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# packaged plugin/skill bundles
*.skill

# git worktrees — dashboard development lives in .worktrees/dashboard;
# main checkout stays pinned to preview so the mac mini's daily_ops cron
# can `git pull --rebase origin preview` against tcgdexter-web without
# tripping on dashboard-branch WIP.
.worktrees/

# Local email design previews (generated)
.email-preview/

# Python bytecode from the scripts/ data exporters (regenerated on every run,
# and version-specific — cpython-314.pyc churns the tree for no benefit)
__pycache__/
*.py[cod]
